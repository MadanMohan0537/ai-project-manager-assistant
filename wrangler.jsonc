{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-project-manager-assistant",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  "ai": { "binding": "AI" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fp8"
  }
}
